<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title %></title>
  <meta name="description" content="<%= page.description %>">
  <% if (page.noindex) { %><meta name="robots" content="noindex, follow"><% } %>
  <link rel="canonical" href="<%= canonicalUrl %>">
  <meta name="theme-color" content="#102d3b">
  <meta property="og:type" content="<%= page.view === 'article' ? 'article' : 'website' %>">
  <meta property="og:site_name" content="<%= site.name %>">
  <meta property="og:title" content="<%= page.title %>">
  <meta property="og:description" content="<%= page.description %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:image" content="<%= site.url %>/assets/images/cs1.jpg">
  <meta property="og:image:alt" content="A vessel making its way through port at sunset">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= page.title %>">
  <meta name="twitter:description" content="<%= page.description %>">
  <meta name="twitter:image" content="<%= site.url %>/assets/images/cs1.jpg">
  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
  <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png">
  <link rel="stylesheet" href="/assets/css/style.css">
  <script defer src="/assets/js/site.js"></script>
  <% if (analyticsEnabled) { %>
  <script defer src="<%= site.analyticsOrigin %>/script.js" data-website-id="<%= site.analyticsWebsiteId %>" data-domains="amicusshippingllc.com,www.amicusshippingllc.com" data-do-not-track="true" data-exclude-search="true"></script>
  <% } %>
  <script type="application/ld+json" nonce="<%= cspNonce %>"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: site.url, logo: site.url + '/assets/images/favicon.svg', contactPoint: { '@type': 'ContactPoint', email: site.email, contactType: 'customer inquiries' } }).replace(/</g, '\\u003c') %></script>
  <% if (currentPath !== '/' && !page.noindex) { %>
  <script type="application/ld+json" nonce="<%= cspNonce %>"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' }, ...(page.view === 'article' ? [{ '@type': 'ListItem', position: 2, name: 'Resources', item: site.url + '/resources' }] : []), { '@type': 'ListItem', position: page.view === 'article' ? 3 : 2, name: page.heading || page.title.split(' | ')[0], item: canonicalUrl }] }).replace(/</g, '\\u003c') %></script>
  <% } %>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="Amicus Shipping LLC home">
        <img src="/assets/images/favicon.svg" width="40" height="40" alt="">
        <span class="brand-type">AMICUS<span>SHIPPING LLC</span></span>
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <% site.nav.forEach(item => { %><a href="<%= item.href %>" <%- currentPath === item.href || (item.href === '/resources' && currentPath.startsWith('/resources/')) ? 'aria-current="page"' : '' %>><%= item.label %></a><% }) %>
      </nav>
      <a class="button button-primary header-cta" href="<%= site.shopUrl %>" data-event="buy_esim_click">Buy eSIM <span aria-hidden="true">↗</span></a>
      <details class="mobile-nav">
        <summary aria-label="Main menu"><span>Menu</span><span class="menu-lines" aria-hidden="true"></span></summary>
        <nav aria-label="Mobile navigation">
          <% site.nav.forEach(item => { %><a href="<%= item.href %>" <%- currentPath === item.href ? 'aria-current="page"' : '' %>><%= item.label %></a><% }) %>
        </nav>
      </details>
    </div>
  </header>
