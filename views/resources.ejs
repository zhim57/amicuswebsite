<%- include('partials/header') %>
<main id="main-content">
  <section class="page-intro">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Resources</li></ol></nav>
      <p class="eyebrow">Amicus field notes</p>
      <h1>A little preparation goes a long way.</h1>
      <p class="lead">Focused guides for seafarers and the people supporting them. Start with travel connectivity, crew-change preparation or the right tool for the job.</p>
    </div>
  </section>
  <section class="section" aria-labelledby="guides-heading">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Practical reading</p><h2 id="guides-heading">Guides from Amicus.</h2></div>
      <div class="resource-list">
        <% resources.forEach(function(resource) { %>
          <article class="resource-row">
            <div><p class="meta"><%= resource.category %> <span aria-hidden="true">/</span> <%= resource.readTime %></p><h3><a href="/resources/<%= resource.slug %>" data-event="resource_view"><%= resource.title %></a></h3><p><%= resource.summary %></p></div>
            <a class="text-link" href="/resources/<%= resource.slug %>" data-event="resource_view" aria-label="Read <%= resource.title %>">Read guide <span aria-hidden="true">→</span></a>
          </article>
        <% }) %>
      </div>
    </div>
  </section>
  <section class="section section-soft" aria-labelledby="resources-tools-heading">
    <div class="container split">
      <div><p class="eyebrow">Working tools</p><h2 id="resources-tools-heading">Ready to take the next step?</h2><p>Go directly to the application or guidance you need.</p></div>
      <div class="stack">
        <div><h3>eSIM help &amp; installation</h3><p>Use the store's help pages for device checks, plan questions and installation guidance.</p><a class="text-link" href="<%= site.helpUrl %>" target="_blank" rel="noopener noreferrer">Open the eSIM help center <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div>
        <div><h3>Petroleum inspection practice</h3><p>An independent study tool for petroleum inspection exam preparation. It does not award certification or replace official examination materials.</p><a class="text-link" href="<%= site.inspectionUrl %>" target="_blank" rel="noopener noreferrer">Open inspection practice <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div>
      </div>
    </div>
  </section>
  <section class="section"><div class="container split"><div><p class="eyebrow">Help improve these guides</p><h2>Have a maritime question or a correction?</h2><p>Tell us which guide you are reading and what would make it more useful.</p></div><div><a class="button button-secondary" href="/contact">Contact Amicus</a></div></div></section>
</main>
<%- include('partials/footer') %>
