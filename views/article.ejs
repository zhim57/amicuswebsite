<%- include('partials/header') %>
<% const ctaHref = cta => cta.siteKey ? site[cta.siteKey] : cta.href; %>
<main id="main-content" data-resource-article>
  <section class="page-intro">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/resources">Resources</a></li><li aria-current="page"><%= page.heading %></li></ol></nav>
      <p class="eyebrow"><%= page.category %></p>
      <h1><%= page.heading %></h1>
      <p class="lead"><%= page.description %></p>
      <p class="small-text">By Amicus Shipping LLC · <%= page.readTime %> · Updated <time datetime="<%= page.dateModified %>"><%= new Date(page.dateModified + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %></time></p>
    </div>
  </section>
  <section class="section">
    <div class="container article-layout">
      <article class="article-body" aria-label="Guide">
        <% page.sections.forEach(section => { %>
          <h2><%= section.heading %></h2>
          <% (section.paragraphs || []).forEach(paragraph => { %><p><%= paragraph %></p><% }) %>
          <% if (section.list) { %><ul><% section.list.forEach(item => { %><li><%= item %></li><% }) %></ul><% } %>
          <% if (section.sources) { %>
            <p class="small-text">Source<%= section.sources.length > 1 ? 's' : '' %>: <% section.sources.forEach((source, index) => { %><%= index ? '; ' : '' %><a href="<%= source.url %>"><%= source.title %></a><% }) %>.</p>
          <% } %>
        <% }) %>
        <div class="callout"><h3><%= page.callout.heading %></h3><p><%= page.callout.text %></p></div>
        <h2>Continue reading</h2>
        <ul><% page.relatedSlugs.forEach(slug => { const related = resources.find(resource => resource.slug === slug); %><li><a href="/resources/<%= related.slug %>" data-event="resource_cta_click"><%= related.title %></a></li><% }) %></ul>
      </article>
      <aside class="article-aside" aria-labelledby="guide-next-heading">
        <p class="eyebrow">Your next step</p>
        <h2 id="guide-next-heading">Put the preparation to use.</h2>
        <p><%= page.nextStep %></p>
        <div class="stack">
          <a class="button button-primary" href="<%= ctaHref(page.primaryCta) %>" data-event="resource_cta_click"><%= page.primaryCta.label %> <span aria-hidden="true">→</span></a>
          <a class="text-link" href="<%= ctaHref(page.secondaryCta) %>" data-event="resource_cta_click"><%= page.secondaryCta.label %></a>
          <a class="text-link" href="/contact" data-event="resource_cta_click">Ask a question or suggest a correction</a>
          <a class="text-link" href="/resources">All resources</a>
        </div>
      </aside>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
