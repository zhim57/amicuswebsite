<%- include('partials/header') %>
<main id="main-content">
  <section class="page-intro"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li>Contact</li></ol></nav><p class="eyebrow">A direct conversation</p><h1>What can we help with?</h1><p class="lead">Tell us about your crew, your journey or the operational problem you’re working on.</p></div></section>
  <section class="section"><div class="container contact-layout">
    <div>
      <% if (form.preparedMailto) { %>
      <div id="email-draft" class="success-panel" tabindex="-1" role="status"><h2>Your email draft is ready</h2><p>Your inquiry has not been sent yet. Open your email app, review the draft and send it to Amicus.</p><div class="inline-links"><a class="button button-primary" href="<%= form.preparedMailto %>" data-event="contact_submit">Open email draft ↗</a><a class="text-link" href="/contact">Start another inquiry</a></div><p class="form-note">No email app? Copy the prepared message below into your email service and send it to <a href="mailto:<%= site.email %>"><%= site.email %></a>.</p></div>
      <% } %>
      <% if (form.preparedBody) { %><div class="field draft-copy"><label for="prepared-message">Copy your prepared message</label><textarea id="prepared-message" rows="8" readonly><%= form.preparedBody %></textarea></div><% } %>
      <% if (Object.keys(form.errors).length) { %>
      <div id="form-errors" class="error-summary" tabindex="-1"><h2>Please check your inquiry</h2><ul><% Object.entries(form.errors).forEach(([field, error]) => { %><li><% if (field !== 'form') { %><a href="#<%= field %>"><%= error %></a><% } else { %><%= error %><% } %></li><% }) %></ul></div>
      <% } %>
      <form action="/contact" method="post" aria-describedby="contact-explanation">
        <input type="hidden" name="formToken" value="<%= form.token %>">
        <div class="honeypot" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
        <div class="form-grid">
        <% const fields = [{ name: 'name', label: 'Name', type: 'text', autocomplete: 'name', max: 100, required: true }, { name: 'email', label: 'Email', type: 'email', autocomplete: 'email', max: 254, required: true }, { name: 'company', label: 'Company', type: 'text', autocomplete: 'organization', max: 140, required: false }, { name: 'phone', label: 'Phone / WhatsApp', type: 'tel', autocomplete: 'tel', max: 60, required: false }]; fields.forEach(field => { %>
          <div class="field"><label for="<%= field.name %>"><%= field.label %><% if (!field.required) { %> <span>(optional)</span><% } %></label><input id="<%= field.name %>" name="<%= field.name %>" type="<%= field.type %>" autocomplete="<%= field.autocomplete %>" maxlength="<%= field.max %>" value="<%= form.values[field.name] || '' %>" <%- field.required ? 'required' : '' %> <%- form.errors[field.name] ? 'aria-invalid="true" aria-describedby="' + field.name + '-error"' : '' %>><% if (form.errors[field.name]) { %><p class="field-error" id="<%= field.name %>-error"><%= form.errors[field.name] %></p><% } %></div>
        <% }); %>
        <% [{name: 'visitorType', label: 'I am a…', options: ['Ship Operator / Manager', 'Manning Company', 'Ship Agent', 'Seafarer', 'Other']}, {name: 'interest', label: 'Interested in', options: ['Crew Connectivity', 'Crew Change', 'Maritime Tools', 'General Inquiry']}].forEach(field => { %>
          <div class="field"><label for="<%= field.name %>"><%= field.label %></label><select id="<%= field.name %>" name="<%= field.name %>" required <%- form.errors[field.name] ? 'aria-invalid="true" aria-describedby="' + field.name + '-error"' : '' %>><option value="">Select an option</option><% field.options.forEach(option => { %><option value="<%= option %>" <%- form.values[field.name] === option ? 'selected' : '' %>><%= option %></option><% }) %></select><% if (form.errors[field.name]) { %><p class="field-error" id="<%= field.name %>-error"><%= form.errors[field.name] %></p><% } %></div>
        <% }); %>
          <div class="field field-full"><label for="message">How can we help?</label><textarea id="message" name="message" rows="6" maxlength="2000" required <%- form.errors.message ? 'aria-invalid="true" aria-describedby="message-error"' : '' %>><%= form.values.message || '' %></textarea><% if (form.errors.message) { %><p class="field-error" id="message-error"><%= form.errors.message %></p><% } %></div>
      </div>
        <p class="form-note" id="contact-explanation">This form prepares an email for you to send from your own email app. Your details are checked by this website but are not saved as an inquiry. See our <a href="/privacy">privacy notice</a>.</p>
        <div class="inline-links"><button class="button button-primary" type="submit">Prepare email <span aria-hidden="true">→</span></button></div>
      </form>
    </div>
    <aside class="contact-aside"><p class="eyebrow">Talk to Amicus</p><h2>Start with what you need.</h2><p>For a business inquiry, useful details include your travel routes, approximate crew numbers and the task you want to simplify.</p><h3>Prefer to email directly?</h3><a href="mailto:<%= site.email %>"><%= site.email %></a><h3>Need eSIM order or setup help?</h3><p>Use the dedicated store for your current plan and order.</p><a class="text-link" href="https://sim.amicusshippingllc.com/support">Visit eSIM support ↗</a><h3 id="existing-sim">Have an existing SIM or recharge?</h3><p>Email Amicus with the product name and your question. Please do not include payment card details, passwords or SIM security codes.</p></aside>
  </div></section>
</main>
<%- include('partials/footer') %>
