<%- include('partials/header') %>
<main id="main-content">
  <section class="hero">
    <div class="container hero-layout">
      <div class="hero-copy">
        <p class="eyebrow"><span class="small-rule" aria-hidden="true"></span> Maritime knowledge. Practical tools.</p>
        <h1>For the people <br>who keep<br><em>ships moving.</em></h1>
        <p class="lead">Crew connectivity, crew-change tools and digital resources shaped around the realities of maritime work.</p>
        <div class="inline-links"><a class="button button-primary" href="/solutions">Explore solutions <span aria-hidden="true">→</span></a><a class="text-link" href="<%= site.shopUrl %>" data-event="buy_esim_click">Buy travel eSIM <span aria-hidden="true">↗</span></a></div>
      </div>
      <figure class="hero-image">
        <img src="/assets/images/cs1.jpg" width="806" height="605" fetchpriority="high" alt="A container vessel passing through port at sunset">
        <figcaption><span>Connected to maritime.</span><span>Focused on people.</span></figcaption>
      </figure>
    </div>
  </section>
  <div class="trust-strip"><div class="container"><span>Maritime at the core</span><span>Built for crews & operators</span><span>Practical digital tools</span><span>A direct line to Amicus</span></div></div>
  <section class="section" id="services">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">What we do</p><h2>Real needs.<br>Useful solutions.</h2></div><p>From the journey to join a vessel to the work around a port call, find the right place to start.</p></div>
      <div class="grid-three pillars">
        <article class="feature-card"><span class="card-number">01 / CONNECT</span><h3>Crew connectivity</h3><p>Mobile data for international travel, crew changes, port calls and time ashore.</p><a class="text-link" href="/seafarers">Explore connectivity <span aria-hidden="true">→</span></a></article>
        <article class="feature-card"><span class="card-number">02 / COORDINATE</span><h3>Crew change & operations</h3><p>Practical digital tools to help coordinate people and recurring maritime tasks.</p><a class="text-link" href="/solutions#operations">Explore operations tools <span aria-hidden="true">→</span></a></article>
        <article class="feature-card"><span class="card-number">03 / KNOW</span><h3>Maritime resources</h3><p>Focused preparation guides and professional tools, collected in one useful place.</p><a class="text-link" href="/resources">Browse resources <span aria-hidden="true">→</span></a></article>
      </div>
    </div>
  </section>
  <section class="section section-dark connectivity-section">
    <div class="container split">
      <div><p class="eyebrow">Amicus eSIM</p><h2>A new port.<br>A familiar connection.</h2><p class="lead">Prepare your mobile data before the next leg of your journey.</p><p>Choose a destination plan, receive your eSIM digitally and follow the store’s setup guidance. Keep maps, messages and travel details within reach on land.</p><div class="inline-links"><a class="button button-light" href="<%= site.shopUrl %>" data-event="buy_esim_click">Find your eSIM <span aria-hidden="true">↗</span></a><a class="text-link" href="<%= site.helpUrl %>">Check your device <span aria-hidden="true">↗</span></a></div><p class="small-text">Coverage and activation depend on your plan and device. Mobile networks serve land and port areas; eSIM is not satellite connectivity at sea.</p></div>
      <div class="journey-panel"><p class="eyebrow">For the journey between vessels</p><ol class="journey-list"><li><span>01</span><div><h3>Before you leave</h3><p>Check your phone and every destination on your itinerary.</p></div></li><li><span>02</span><div><h3>On your way</h3><p>Prepare your eSIM with a reliable internet connection.</p></div></li><li><span>03</span><div><h3>When you arrive</h3><p>Follow your plan’s activation steps and get connected.</p></div></li></ol><a class="text-link" href="/resources/esim-before-you-travel" data-event="resource_view">Read the travel checklist <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
  <section class="section audience-section"><div class="container"><p class="eyebrow">Find your way</p><h2>Where do you fit in?</h2><div class="audience-list">
    <a href="/seafarers" data-event="seafarer_cta_click"><span class="meta">For individuals</span><span><strong>I am a seafarer</strong><span>Mobile data, device checks and help getting started.</span></span><span class="round-arrow" aria-hidden="true">↗</span></a>
    <a href="/operators"><span class="meta">For businesses</span><span><strong>I manage crews or vessels</strong><span>Connectivity and practical tools for your people.</span></span><span class="round-arrow" aria-hidden="true">↗</span></a>
    <a href="/resources"><span class="meta">For professionals</span><span><strong>I work in maritime</strong><span>Operational resources and tools for everyday work.</span></span><span class="round-arrow" aria-hidden="true">↗</span></a>
  </div></div></section>
  <section class="section section-soft"><div class="container split about-preview"><div><p class="eyebrow">The thinking behind Amicus</p><h2>Maritime knowledge,<br>put to work.</h2></div><div><p class="lead">Good tools begin with an understanding of the work.</p><p>Amicus Shipping brings a practical maritime perspective to connectivity and digital tools. Our focus is straightforward: help people prepare for travel, coordinate crew activity and find information they can use.</p><a class="text-link" href="/about">About Amicus <span aria-hidden="true">→</span></a></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">From the resources desk</p><h2>A little preparation<br>goes a long way.</h2></div><a class="text-link" href="/resources">All resources <span aria-hidden="true">→</span></a></div><div class="resource-list">
    <% resources.forEach((resource, i) => { %><a class="resource-row" href="/resources/<%= resource.slug %>" data-event="resource_view"><span class="resource-index">0<%= i + 1 %></span><div><span class="meta"><%= resource.category %> · <%= resource.readTime %></span><h3><%= resource.title %></h3></div><span aria-hidden="true">↗</span></a><% }) %>
  </div></div></section>
  <section class="final-cta"><div class="container"><div><p class="eyebrow">Your next step</p><h2>Let’s make the<br>next journey simpler.</h2></div><div class="cta-paths"><div><p>Need connectivity?</p><a class="button button-primary" href="<%= site.shopUrl %>" data-event="buy_esim_click">Buy eSIM <span aria-hidden="true">↗</span></a></div><div><p>Have a business need?</p><a class="text-link" href="/contact" data-event="operator_inquiry">Talk to Amicus <span aria-hidden="true">→</span></a></div></div></div></section>
</main>
<%- include('partials/footer') %>
