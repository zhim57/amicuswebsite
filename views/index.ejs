<%- include('partials/header') %>
<main id="main-content">
  <section class="hero">
    <div class="container hero-layout">
      <div class="hero-copy">
        <p class="eyebrow"><span class="small-rule" aria-hidden="true"></span> Maritime knowledge. Practical tools.</p>
        <h1>For the people <br>who keep<br><em>ships moving.</em></h1>
        <p class="lead">Crew connectivity, crew-change tools and digital resources shaped around the realities of maritime work.</p>
        <div class="inline-links"><a class="button button-primary" href="<%= site.shopUrl %>" data-event="buy_esim_click">Buy travel eSIM <span aria-hidden="true">→</span></a><a class="text-link" href="/solutions">Explore solutions <span aria-hidden="true">→</span></a></div>
      </div>
      <figure class="hero-image">
        <img src="/assets/images/cs1.jpg" width="806" height="605" fetchpriority="high" alt="A container vessel passing through port at sunset">
        <figcaption><span>Connected to maritime.</span><span>Focused on people.</span></figcaption>
      </figure>
    </div>
  </section>
  <div class="trust-strip"><div class="container"><span>Ship-agency experience</span><span>Built for crews &amp; operators</span><span>Maritime knowledge behind the tools</span><span><a href="/about">Meet the founder</a></span></div></div>
  <section class="section" id="services">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">What we do</p><h2>Real needs.<br>Useful solutions.</h2></div><p>From the journey to join a vessel to the work around a port call, find the right place to start.</p></div>
      <div class="grid-three pillars">
        <article class="feature-card"><span class="card-number">01 / CONNECT</span><h3>Amicus eSIM</h3><p>Arrange mobile data for international travel, crew changes, port calls and time ashore.</p><a class="text-link" href="<%= site.shopUrl %>" data-event="buy_esim_click">Find an eSIM plan <span aria-hidden="true">→</span></a></article>
        <article class="feature-card"><span class="card-number">02 / PREPARE</span><h3>Connectivity for your crew</h3><p>Discuss joining-crew connectivity, individual discount-code batches and repeat travel routes.</p><a class="text-link" href="/operators">For operators &amp; managers <span aria-hidden="true">→</span></a></article>
        <article class="feature-card"><span class="card-number">03 / COORDINATE</span><h3>Amicus Crew Change</h3><p>Bring trip details, journey stages and updates into a shared crew-change workflow.</p><a class="text-link" href="<%= site.crewLandingUrl %>">Explore the crew-change tool <span aria-hidden="true">→</span></a></article>
      </div>
    </div>
  </section>
  <section class="section section-dark connectivity-section">
    <div class="container split">
      <div><p class="eyebrow">Amicus eSIM</p><h2>A new port.<br>A familiar connection.</h2><p class="lead">Prepare your mobile data before the next leg of your journey.</p><p>Choose a destination plan, receive your eSIM digitally and follow the store’s setup guidance. Keep maps, messages and travel details within reach on land.</p><div class="inline-links"><a class="button button-light" href="<%= site.shopUrl %>" data-event="buy_esim_click">Find your eSIM <span aria-hidden="true">→</span></a><a class="text-link" href="<%= site.helpUrl %>">Check your device <span aria-hidden="true">→</span></a></div><p class="small-text">Coverage and activation depend on your plan and device. Mobile networks serve land and port areas; eSIM is not satellite connectivity at sea.</p></div>
      <div class="journey-panel"><p class="eyebrow">For the journey between vessels</p><ol class="journey-list"><li><span>01</span><div><h3>Before you leave</h3><p>Check your phone and every destination on your itinerary.</p></div></li><li><span>02</span><div><h3>On your way</h3><p>Prepare your eSIM with a reliable internet connection.</p></div></li><li><span>03</span><div><h3>When you arrive</h3><p>Follow your plan’s activation steps and get connected.</p></div></li></ol><a class="text-link" href="/resources/esim-before-you-travel">Read the travel checklist <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
  <section class="section audience-section"><div class="container"><p class="eyebrow">Find your way</p><h2>Where do you fit in?</h2><div class="audience-list">
    <a href="/seafarers" data-event="seafarer_cta_click"><span class="meta">For individuals</span><span><strong>I am a seafarer</strong><span>Mobile data, device checks and help getting started.</span></span><span class="round-arrow" aria-hidden="true">→</span></a>
    <a href="/operators"><span class="meta">For businesses</span><span><strong>I manage crews or vessels</strong><span>Connectivity and practical tools for your people.</span></span><span class="round-arrow" aria-hidden="true">→</span></a>
    <a href="/resources"><span class="meta">For professionals</span><span><strong>I work in maritime</strong><span>Operational resources and tools for everyday work.</span></span><span class="round-arrow" aria-hidden="true">→</span></a>
  </div></div></section>
  <section class="section section-soft"><div class="container split about-preview"><div><p class="eyebrow">The maritime background</p><h2>Experience around vessels.<br>Tools for the people.</h2></div><div><p class="lead">Ship agency, marine superintendent work and petroleum inspection.</p><p>These are part of founder Jivko Atanassov's professional background. Amicus applies that experience to the next handover, the next crew rotation and the communication needed along the way.</p><a class="text-link" href="/about">Meet the founder and read the story <span aria-hidden="true">→</span></a></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">From the resources desk</p><h2>A little preparation<br>goes a long way.</h2></div><a class="text-link" href="/resources">All resources <span aria-hidden="true">→</span></a></div><div class="resource-list">
    <% resources.forEach((resource, i) => { %><a class="resource-row" href="/resources/<%= resource.slug %>"><span class="resource-index">0<%= i + 1 %></span><div><span class="meta"><%= resource.category %> · <%= resource.readTime %></span><h3><%= resource.title %></h3></div><span aria-hidden="true">→</span></a><% }) %>
  </div></div></section>
  <section class="final-cta"><div class="container"><div><p class="eyebrow">Your next step</p><h2>Let’s make the<br>next journey simpler.</h2></div><div class="cta-paths"><div><p>Need connectivity?</p><a class="button button-primary" href="<%= site.shopUrl %>" data-event="buy_esim_click">Buy eSIM <span aria-hidden="true">→</span></a></div><div><p>Planning for your crew?</p><a class="text-link" href="<%= site.inquiryUrls.connectivity %>" data-event="operator_inquiry">Discuss Crew Connectivity <span aria-hidden="true">→</span></a></div></div></div></section>
</main>
<%- include('partials/footer') %>
