# Existing VPS/PM2 runtime settings
PORT=3016
NODE_ENV=production
# Legacy deny boundary only; the app never creates, lists or serves this directory.
# Delete obsolete upload files separately on the actual server; git pull will not.
UPLOAD_DIR=./uploads
# Set to loopback only when a local trusted proxy fronts Node and Node is not public.
TRUST_PROXY=false
# Optional: stable secret of at least 32 random characters across workers/restarts.
# CONTACT_FORM_SECRET=
# Contact delivery: configure a working SMTP account before enabling production inquiries.
# Missing/invalid settings return a safe error and keep the existing direct-email fallback.
# Never put SMTP credentials in public files, browser code, or analytics.
# SMTP_HOST=
SMTP_PORT=587
# Port 587 uses required STARTTLS. For implicit TLS on port 465 set this to true.
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# A single sender mailbox authorized by the SMTP provider (no display-name syntax).
# SMTP_FROM=
# Optional single recipient; defaults to the existing corporate address in src/site-data.js.
# CONTACT_TO=
# Change the centralized public site.email separately after a branded inbox is verified.
# Production only; set false to disable the existing analytics tracker.
ANALYTICS_ENABLED=true
